# Postgres (Neon). DATABASE_URL = dev branch (local runs, previews).
# DATABASE_URL_PROD = prod branch (the daily job publishes here). Local Docker DB for development:
#   postgresql://tipoff:tipoff@localhost:5433/tipoff
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_PROD=postgresql://user:password@host/db?sslmode=require

# MLflow tracking. Defaults to a SQLite store at ml/mlflow.db with artifacts in ml/mlartifacts.
# MLFLOW_TRACKING_URI=sqlite:////absolute/path/to/mlflow.db

# Optional: the site's public URL for canonical links, the sitemap and share images (web/lib/site.ts).
# Defaults to the production vercel.app URL; set it in Vercel when a custom domain is connected.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Vercel only (Production): the Vercel Schedules in web/vercel.json call /api/cron/<job>, which
# starts the GitHub workflow. CRON_SECRET: random, 16+ header-safe characters (Vercel sends it as
# a Bearer header). GITHUB_DISPATCH_TOKEN: fine-grained token, this repo only, Actions read+write.
# CRON_SECRET=
# GITHUB_DISPATCH_TOKEN=

# Only needed for scripts/assets/meshy_pipeline.py
MESHY_API_KEY=
