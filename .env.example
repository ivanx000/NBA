# Postgres (Neon). DATABASE_URL = dev branch (local runs, previews).
# DATABASE_URL_PROD = prod branch (the daily job publishes here). Local Docker DB for development:
#   postgresql://tipoff:tipoff@localhost:5433/tipoff
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_PROD=postgresql://user:password@host/db?sslmode=require

# MLflow tracking. Defaults to a SQLite store at ml/mlflow.db with artifacts in ml/mlartifacts.
# MLFLOW_TRACKING_URI=sqlite:////absolute/path/to/mlflow.db

# Only needed for scripts/assets/meshy_pipeline.py
MESHY_API_KEY=
