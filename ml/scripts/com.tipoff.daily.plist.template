<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by ml/scripts/install_launchd.sh. Times are local (this Mac is on US Eastern). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tipoff.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DAILY_SH__</string>
  </array>
  <!-- 09:30, then hourly retries to 18:30; each run exits early once today is published. -->
  <key>StartCalendarInterval</key>
  <array>
__INTERVALS__
  </array>
  <!-- Also run at login, so a Mac that was shut down at 09:30 catches up when it starts. -->
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__LOG_DIR__/daily.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/daily.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
